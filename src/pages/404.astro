---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";

const recent = (await getSortedPosts()).slice(0, 4);
---
<MainGridLayout title="Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı.">
    <div class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center text-center onload-animation">
        <div class="text-8xl font-bold text-black/90 dark:text-white/90 tracking-tight">404</div>
        <h1 class="mt-4 text-2xl font-bold text-black/90 dark:text-white/90">Bu sayfa yolda kaybolmuş gibi görünüyor 🧭</h1>
        <p class="mt-3 text-black/60 dark:text-white/60 max-w-md">
            Aradığınız sayfa taşınmış, adı değişmiş ya da hiç var olmamış olabilir.
            Üstteki arama kutusunu kullanabilir ya da aşağıdan devam edebilirsiniz.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 justify-center">
            <a href={url("/")} class="btn-regular rounded-lg h-11 px-5 font-bold active:scale-95">Ana sayfaya dön</a>
            <a href={url("/archive/")} class="btn-regular rounded-lg h-11 px-5 font-bold active:scale-95">Tüm yazılar</a>
        </div>

        {recent.length > 0 && (
            <div class="mt-12 w-full max-w-md text-left">
                <div class="text-sm font-bold text-black/50 dark:text-white/50 mb-3">Son yazılar</div>
                <ul class="flex flex-col gap-1">
                    {recent.map((post) => (
                        <li>
                            <a href={getPostUrlBySlug(post.slug)}
                               class="block rounded-lg px-3 py-2 transition text-black/80 dark:text-white/80 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]">
                                {post.data.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </div>
</MainGridLayout>
